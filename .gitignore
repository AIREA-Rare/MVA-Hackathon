*.pdb
*.cif
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.npz
*.pkl
# Secrets
.env
.env.*
*.pem
*.key
# Local noise
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.log
