{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PatchLens output record v0.1.0 (proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "passport_id", "data_class", "backend", "input",
    "applicability", "metrics", "uncertainty_notes", "boundaries", "evidence_tier",
    "call", "artifact_sha256", "acceptance_record", "provenance"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "record_id": { "type": "string", "minLength": 1 },
    "passport_id": { "type": "string", "minLength": 1 },
    "data_class": { "enum": ["synthetic", "permitted_summary"] },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "parameter_hash"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "parameter_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gene", "transcript", "protein_accession", "residue_ref", "residue_position",
        "residue_alt", "structure_source", "structure_chain", "structure_sha256"
      ],
      "properties": {
        "gene": { "type": ["string", "null"] },
        "transcript": { "type": ["string", "null"] },
        "protein_accession": { "type": ["string", "null"] },
        "residue_ref": { "type": ["string", "null"] },
        "residue_position": { "type": ["integer", "null"], "minimum": 1 },
        "residue_alt": { "type": ["string", "null"] },
        "structure_source": { "type": ["string", "null"] },
        "structure_chain": { "type": ["string", "null"] },
        "structure_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["available", "not_assessed", "abstain"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": ["number", "null"] }
    },
    "uncertainty_notes": { "type": "array", "items": { "type": "string" } },
    "boundaries": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidence_tier": { "const": "E4" },
    "call": { "type": "null" },
    "artifact_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "acceptance_record": { "type": ["string", "null"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure_license", "attribution"],
      "properties": {
        "structure_license": { "type": ["string", "null"] },
        "attribution": { "type": ["string", "null"] }
      }
    }
  }
}
